generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @db.Date
  email     String   @unique
  name      String
  password  String
  role      String
  updatedAt DateTime @db.Date
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  color     String
  createdAt DateTime @db.Date
  name      String
  updatedAt DateTime @db.Date
}

model Item {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  brand           String
  category        String
  countryOfOrigin String
  createdAt       DateTime @db.Date
  dateOfPurchase  DateTime @db.Date
  description     String
  imageUrl        String
  images          String[]
  isAvailable     Boolean
  name            String
  pricePerDay     Int
  purchasedCost   Int
  updatedAt       DateTime @db.Date
  warrantyPeriod  String
  rentals   Rental[]
}

model Rental {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @db.Date
  endDate   DateTime @db.Date
  itemId    String   @db.ObjectId
  startDate DateTime @db.Date
  status    String
  totalCost Int
  updatedAt DateTime @db.Date
  userId    String   @db.ObjectId
  item   Item   @relation(fields: [itemId], references: [id])
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @db.Date
  email     String   @unique
  name      String
  password  String
  phone     String?
  role      String
  updatedAt DateTime @db.Date
}
